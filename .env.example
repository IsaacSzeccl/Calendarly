# Calendarly environment variables. Copy to .env.local and fill in.
# This file holds names and placeholders only. Never put real keys here, and never commit .env.local.
# On Vercel, add the same names under Project Settings > Environment Variables.

# --- App ---
# Public address of the app. Local: http://localhost:3000. Deployed: your custom domain or Vercel URL.
APP_URL=http://localhost:3000

# --- Supabase (database + organizer sign-in) ---
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google (organizer sign-in via Supabase, and Calendar access) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Redirect URIs to register: Supabase's Google callback, plus APP_URL + /api/calendar/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Calendar token encryption ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=generate-a-random-32-byte-base64-value

# --- AI model (GLM from Z.ai, behind a swappable adapter) ---
# Verify the base URL and model ID in the Z.ai docs. Coding-plan keys may use a different base URL.
AI_BASE_URL=https://api.z.ai/api/paas/v4/
AI_API_KEY=your-z-ai-api-key
AI_MODEL=your-glm-model-id

# --- Email (Brevo) ---
# SMTP (used by the deployed app)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login-email
BREVO_SMTP_KEY=your-brevo-smtp-key
# HTTPS API key (optional, for environments where SMTP is blocked)
BREVO_API_KEY=your-brevo-api-key
# Must be a sender or domain verified in Brevo
EMAIL_FROM="Calendarly <hello@your-domain.example>"

# --- Testing only ---
# Enables the test-only login and the in-memory fake calendar. Leave unset in production.
# E2E_TEST_MODE=1
# Run the AI evals against the real model instead of recorded answers.
# LIVE=1
